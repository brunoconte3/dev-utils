{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debugar Projeto",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "pathMappings": {
        "/var/www/html/${workspaceFolderBasename}": "${workspaceFolder}"
      }
    },
    {
      "name": "Debugar Script",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "port": 9003
    }
  ]
}